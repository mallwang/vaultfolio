<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;background:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6"><tr><td align="center" style="padding:24px 12px">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%">
<tr><td style="background:#0f766e;border-radius:10px 10px 0 0;padding:20px 32px;font-size:20px;font-weight:700;color:#ffffff">{{> header-en}}</td></tr>
<tr><td style="background:#ffffff;padding:32px;border-radius:0 0 10px 10px;font-size:15px;line-height:24px;color:#1f2937">
{{> @partial-block}}
</td></tr>
<tr><td style="padding:20px 8px;font-size:12px;line-height:18px;color:#9ca3af;text-align:center">
<p style="margin:0 0 8px">{{> footer-en}}{{#if recipientEmail}}<br>This email was sent to <strong style="color:#6b7280">{{recipientEmail}}</strong>.{{/if}}</p>
<p style="margin:0 0 8px">{{#if appHomeUrl}}<a href="{{appHomeUrl}}" style="color:#6b7280;text-decoration:underline">Open Vaultfolio</a> &nbsp;·&nbsp; {{/if}}<a href="https://github.com/mallwang/vaultfolio" style="color:#6b7280;text-decoration:underline">GitHub</a></p>
<p style="margin:0">&copy; {{copyrightYear}} Vaultfolio</p>
</td></tr>
</table>
</td></tr></table>
</body></html>
