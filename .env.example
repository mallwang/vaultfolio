# /home/markus/projects/vaultfolio/.env
# Must be an absolute URL including the http(s) protocol — invitation emails
# link to "$APP_BASE_URL/invite/<token>", and a schemeless/relative value
# renders as a dead "about:blank#blocked" link in most email clients.
APP_BASE_URL=http://localhost:4200
BOOTSTRAP_ADMIN_EMAIL=markus.allwang@tuta.com
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_LIFETIME_HOURS=12
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=vaultfolio@example.com
# Optional. When set, outbound emails' From header shows this display name
# next to SMTP_FROM (e.g. "Vaultfolio <vaultfolio@example.com>") instead of
# the bare address — safely RFC 5322/2047-encoded by nodemailer even if the
# value contains a quote/comma. When unset, From falls back to the bare
# SMTP_FROM address (today's behavior).
SMTP_SENDER_NAME=Vaultfolio
# Turnstile (bot protection)
# Leave TURNSTILE_SECRET_KEY empty to skip verification entirely (no Turnstile widget needed).
# For local dev with the widget: use Cloudflare's test secret — auto-approves tokens from test site key 1x00000000000000000000AA.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Comma-separated hostname allow-list (e.g. "yourdomain.com,www.yourdomain.com")
# Leave empty to allow any hostname (fine for local dev, not recommended for prod)
TURNSTILE_HOSTNAMES=
ACCOUNT_RETENTION_DAYS=30
INVITATION_EXPIRY_DAYS=7
PUBLIC_SIGNUP_ENABLED=true
SIGNUP_EXPIRY_HOURS=24
EMAIL_CHANGE_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_HOURS=1
