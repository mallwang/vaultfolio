    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@primeuix/themes": "^3.0.0",
    "argon2": "^0.41.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "echarts": "^6.1.0",
    "handlebars": "^4.7.9",
    "primeng": "^22.1.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
