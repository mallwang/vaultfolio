meta {
  name: Rotate Master Key (admin)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/encryption/domains/wealth/master-key-rotation
  body: none
  auth: none
}

docs {
  Re-wraps all data keys of the domain under the current master key (set the old key as <DOMAIN>_ENCRYPTION_KEY_PREVIOUS first).
  Admin-only request — requires the `vaultfolio_session` cookie of an ADMIN
  account, captured by `auth/Login`.
}
