meta {
  name: Forgot Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/profile/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "someone@example.com",
    "turnstileToken": "REPLACE_WITH_REAL_TURNSTILE_TOKEN"
  }
}

docs {
  Unauthenticated request (SC-003). Requires a real Cloudflare Turnstile
  token to pass `TurnstileGuard`.
}
